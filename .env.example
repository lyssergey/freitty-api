# --- App ---
NODE_ENV=development
PORT=3001
# Comma-separated browser origins allowed by CORS. The front proxies /api/* server-side,
# so this only matters for direct browser calls to the API.
CORS_ORIGINS=http://localhost:3000
# Business time zone: "today" / "this week" filters, activity buckets, CSV dates.
APP_TIMEZONE=America/Toronto
# Auth is out of scope: every request acts as this seeded user.
DEMO_USER_EMAIL=user1@rway-transport.example

# --- Database (PostgreSQL, e.g. Neon) ---
# Neon: use the pooled connection string, without `sslmode` (TLS is set by DB_SSL).
DATABASE_URL=postgres://user:password@host/dbname
# Dedicated schema for all app tables + the TypeORM `migrations` table.
# Required by the seed; `public` is refused (the database may be shared).
DB_SCHEMA=freitty
# true = TLS with certificate verification (required by Neon).
DB_SSL=true
DB_LOGGING=false
